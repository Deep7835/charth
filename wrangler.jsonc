{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds project "charth").
  "name": "charth",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext; the service name must equal "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "charth"
    }
  ],
  "observability": {
    "enabled": true
  }
}
